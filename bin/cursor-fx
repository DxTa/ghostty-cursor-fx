 "label_ENTER_EFFECT": "回车",
 "label_DONE_EFFECT": "完成",
 "label_LINE_TINT": "线条着色",
 "label_LINE_COLOR": "着色强度",
 "label_LINE_EFFECT": "动态线条",
 "label_BACK_THRUST": "退格推进",
 "label_PHRASE_EFFECT": "中文输入"
}
};
let LANG = (() => {
  try { const s = localStorage.getItem("cursor-fx-lang"); if (s === "en" || s === "zh") return s; } catch (e) {}
  return /^zh/i.test(STATE.sysLang || navigator.language || "") ? "zh" : "en";
})();
function t(key, vars) { let s = UI[LANG][key] ?? UI.en[key] ?? key; for (const k in vars || {}) s = s.split("{" + k + "}").join(vars[k]); return s; }
const nameOf = e => LANG === "zh" && ZH.effects[e.name] ? ZH.effects[e.name][0] : e.name;
const descOf = e => LANG === "zh" && ZH.effects[e.name] ? ZH.effects[e.name][1] : e.description;
// English labels where the constant's own name reads badly.
const EN_NAMES = { DECODE_STYLE: "Decrypt style", WORD_DECODE: "Word decrypt", TYPE_PULSE: "Data pulses", TYPE_BEAM: "Write beam",
  TYPE_KICK: "Cursor kick", DECODE_TIME: "Decrypt time", TYPE_TIME: "Typing light" };
const labelOf = s => LANG === "zh" && ZH.names[s.name] ? ZH.names[s.name] : EN_NAMES[s.name] || humanize(s.name);
const groupOf = g => LANG === "zh" && ZH.groups && ZH.groups[g] ? ZH.groups[g] : g;
// An int whose note ends in "...: 0 one, 1 two, 2 three" is a choice: {help, items: [[0, "One"], ...]}.
function choicesOf(s) {
  const m = helpOf(s).match(/^(.*?)[:：]\s*((?:\d+\s*[^,，]+[,，]\s*)+\d+\s*[^,，]+)$/);
  if (!m) return null;
  const items = m[2].split(/[,，]\s*/).map(x => { const k = x.match(/^(\d+)\s*(.+)$/); return k ? [Number(k[1]), k[2].trim().replace(/^./, c => c.toUpperCase())] : null; });
  return items.every(Boolean) ? { help: m[1], items } : null;
}
// "typing: how each letter decrypts" under the Typing heading reads "how each letter decrypts".
function noteFor(text, group) {
  if (!text || !group) return text;
  for (const g of [group, groupOf(group)]) {
    const low = text.toLowerCase(), pre = g.toLowerCase();
    for (const sep of [": ", "："]) if (low.startsWith(pre + sep)) return text.slice(pre.length + sep.length);
  }
  return text;
}
const helpOf = s => LANG === "zh" && ZH.comments[s.comment] ? ZH.comments[s.comment] : s.comment;
function applyLang() {
  document.documentElement.lang = LANG === "zh" ? "zh-CN" : "en"; document.title = t("title");
  $("#hTitle").textContent = t("title"); $("#lAll").textContent = t("allEffects"); $("#lEnter").textContent = t("enterSw"); $("#enterLabel").title = t("enterTip"); $("#lJumps").textContent = t("jumpsSw"); $("#jumpsLabel").title = t("jumpsTip");
  $("#lIdle").textContent = t("idleSw"); $("#idleLabel").title = t("idleTip");
  $("#doneBtn").textContent = t("done"); $("#doneBtn").title = t("doneTip");
  $("#langBtn").textContent = LANG === "zh" ? "English" : "中文"; $("#langBtn").title = t("langTip");
}

// --- preview: the shader itself, run in WebGL over a drawn terminal --------
const W = 1200, H = 420, CH = 44, PADX = 16, PADY = 12, ROW = 6;
const term = document.createElement("canvas"); term.width = W; term.height = H;
const tc = term.getContext("2d"); tc.font = "30px Menlo, Consolas, monospace"; const CW = tc.measureText("M").width;
const cv = document.createElement("canvas"); cv.width = W; cv.height = H;
const gl = cv.getContext("webgl2", { preserveDrawingBuffer: true });
const PRELUDE = `#version 300 es
precision highp float; precision highp int;
uniform vec3 iResolution; uniform float iTime;
uniform vec4 iCurrentCursor; uniform vec4 iPreviousCursor;
uniform vec4 iCurrentCursorColor; uniform vec4 iPreviousCursorColor;
uniform int iCurrentCursorStyle; uniform int iCursorVisible;
uniform float iTimeCursorChange; uniform int iFocus;
uniform vec3 iPalette[16];
uniform vec3 iBackgroundColor; uniform vec3 iForegroundColor; uniform vec3 iCursorText;
#define CURSORSTYLE_BLOCK 0
uniform sampler2D iChannel0;
out vec4 _fragColor;
vec4 texLin(sampler2D s, vec2 uv) { vec4 c = texture(s, uv); return vec4(pow(c.rgb, vec3(2.2)), c.a); }
#define texture texLin
`;
const POST = `
void main() { vec4 c; mainImage(c, ${STATE.yDown ? "vec2(gl_FragCoord.x, iResolution.y - gl_FragCoord.y)" : "gl_FragCoord.xy"}); _fragColor = vec4(pow(c.rgb, vec3(1.0 / 2.2)), 1.0); }
`;
let prog = null, uni = {}, previewError = null;
function compileShader(type, src) { const s = gl.createShader(type); gl.shaderSource(s, src); gl.compileShader(s); if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s)); return s; }
function buildProgram(source) {
  const p = gl.createProgram();
  gl.attachShader(p, compileShader(gl.VERTEX_SHADER, "#version 300 es\nin vec2 pos; void main() { gl_Position = vec4(pos, 0.0, 1.0); }"));
  gl.attachShader(p, compileShader(gl.FRAGMENT_SHADER, PRELUDE + source + POST));
  gl.linkProgram(p);
  if (!gl.getProgramParameter(p, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(p));
  return p;
}
const buf = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, buf); gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
const tex = gl.createTexture(); gl.bindTexture(gl.TEXTURE_2D, tex); gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, !STATE.yDown);
for (const [k, v] of [[gl.TEXTURE_MIN_FILTER, gl.NEAREST], [gl.TEXTURE_MAG_FILTER, gl.NEAREST], [gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE], [gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE]]) gl.texParameteri(gl.TEXTURE_2D, k, v);
gl.viewport(0, 0, W, H);
function usePreview(source) {
  try { const p = buildProgram(source); if (prog) gl.deleteProgram(prog); prog = p; previewError = null; }
  catch (e) { previewError = String(e.message || e); return; }
  gl.useProgram(prog);
  const loc = gl.getAttribLocation(prog, "pos"); gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
  uni = {}; for (const n of ["iResolution", "iTime", "iCurrentCursor", "iPreviousCursor", "iCurrentCursorColor", "iPreviousCursorColor", "iCurrentCursorStyle", "iCursorVisible", "iTimeCursorChange", "iFocus", "iPalette", "iBackgroundColor", "iForegroundColor", "iCursorText", "iChannel0"]) uni[n] = gl.getUniformLocation(prog, n);
  const c = STATE.colors;
  gl.uniform3f(uni.iResolution, W, H, 1);
  gl.uniform3f(uni.iBackgroundColor, ...hexToRgb(c.background));
  gl.uniform3f(uni.iForegroundColor, ...hexToRgb(c.foreground));
  gl.uniform3f(uni.iCursorText, ...hexToRgb(c.cursorText || c.background));
  gl.uniform1i(uni.iCurrentCursorStyle, 0); gl.uniform1i(uni.iCursorVisible, 1); gl.uniform1i(uni.iFocus, 1); gl.uniform1i(uni.iChannel0, 0);
  const pal = new Float32Array(48);
  const fallback = ["#000000", "#cc0000", "#4e9a06", "#c4a000", "#3465a4", "#75507b", "#06989a", "#d3d7cf", "#555753", "#ef2929", "#8ae234", "#fce94f", "#729fcf", "#ad7fa8", "#34e2e2", "#eeeeec"];
  for (let i = 0; i < 16; i++) pal.set(hexToRgb(c.palette[i] || fallback[i]), i * 3);
  gl.uniform3fv(uni.iPalette, pal);
  drawTerm();
}
// The drawn terminal: a Claude Code-like screen with a sent prompt on a bar, the
// input box between two lines, and a status line.
const sim = { preedit: "", input: "", sent: "make the cursor effects awesome", cur: 2, prev: 2, prevRow: 0, change: 0, signalUntil: 0, signalPrev: false, kind: "enter", color: "#f85552" };
function lighten(hex, k) { return rgbToHex(hexToRgb(hex).map(v => v + (1 - v) * k)); }
// Chinese, Japanese and Korean characters take two cells, as in the terminal.
const WIDE = /[\u1100-\u115F\u2E80-\u303E\u3041-\u33FF\u3400-\u4DBF\u4E00-\u9FFF\uA000-\uA4CF\uAC00-\uD7A3\uF900-\uFAFF\uFE30-\uFE4F\uFF00-\uFF60\uFFE0-\uFFE6]|[\u{20000}-\u{3FFFD}]/u;
const cellsOf = text => Array.from(text).reduce((n, ch) => n + (WIDE.test(ch) ? 2 : 1), 0);
// Text drawn cell by cell from a column; returns the column after it.
function drawCells(text, col, row, color) {
  tc.fillStyle = color;
  for (const ch of Array.from(text)) {
    const x = PADX + col * CW, y = PADY + row * CH + 6;
    if (WIDE.test(ch)) {
      tc.save(); tc.font = `${Math.round(CH * 0.66)}px "PingFang SC", "Hiragino Sans GB", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif`;
      tc.fillText(ch, x + (2 * CW - tc.measureText(ch).width) / 2, y + 1); tc.restore(); col += 2;
    } else { tc.fillText(ch, x, y); col += 1; }
  }
  return col;
}
function drawTerm() {
  const c = STATE.colors, bg = c.background, fg = c.foreground;
  tc.fillStyle = bg; tc.fillRect(0, 0, W, H); tc.textBaseline = "top";
  tc.fillStyle = lighten(bg, 0.06); tc.fillRect(0, PADY + 2 * CH, W, CH);
  tc.fillStyle = lighten(bg, 0.3); for (const r of [5, 7]) tc.fillRect(PADX, PADY + r * CH + CH / 2 - 1, W - 2 * PADX, 2);
  const lines = ["● Done: the effects are installed.", "", "❯ " + sim.sent, "", "✻ Thinking…", "", "", "", "  Opus 5.5 ¦ Ghostty ¦ ctx 32%"];
  lines.forEach((l, r) => { if (r === 2 || r === ROW) return; tc.fillStyle = r === 8 ? lighten(bg, 0.35) : fg; tc.fillText(l, PADX, PADY + r * CH + 6); });
  drawCells("❯ " + sim.sent, 0, 2, fg);
  drawCells("❯ " + sim.input, 0, ROW, fg);
  if (sim.preedit) {
    // Text the input method is still composing: underlined at the cursor, the cursor hidden.
    const end = drawCells(sim.preedit, sim.cur, ROW, fg);
    tc.fillStyle = fg; tc.fillRect(Math.round(PADX + sim.cur * CW), PADY + ROW * CH + CH - 5, Math.round((end - sim.cur) * CW), 2);
  } else {
    tc.fillStyle = sim.color; tc.fillRect(Math.round(PADX + sim.cur * CW), PADY + ROW * CH, Math.round(CW), CH);
  }
  gl.bindTexture(gl.TEXTURE_2D, tex); gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, term);
}
// Ghostty on macOS (Metal) hands shaders y-down pixels, the cursor's .y being
// its bottom edge; on Linux (OpenGL) y-up, .y the top edge. The preview does the
// same as the Ghostty on this machine (see POST and the texture's FLIP_Y).
const rect = (row, col) => [Math.round(PADX + col * CW), STATE.yDown ? PADY + (row + 1) * CH : H - (PADY + row * CH), Math.round(CW), CH];
// The preview's clock: seconds, running at SPEED (slow motion below 1); its timers follow it.
let SPEED = 1, ZOOM = 1, clockBase = 0, clockReal = performance.now();
const now = () => clockBase + (performance.now() - clockReal) / 1000 * SPEED;
function setSpeed(v) { clockBase = now(); clockReal = performance.now(); SPEED = v; lastAction = now(); }
const later = (fn, ms) => setTimeout(fn, ms / SPEED);
// The preview runs at full rate for a few seconds after anything happens, then
// ticks slowly (idle animations still move) so a panel left open costs little.
let lastAction = 0, frameNo = 0;
function oddBlue(hex) { const c = hexToRgb(hex); return [c[0], c[1], (Math.round(c[2] * 255) | 1) / 255]; }
function oddGreen(hex) { const c = hexToRgb(hex); return [c[0], (Math.round(c[1] * 255) | 1) / 255, c[2]]; }
function frame() {
  requestAnimationFrame(frame);
  if (!prog || document.hidden) return;
  frameNo++;
  if (now() - lastAction > 4 && frameNo % 10 !== 0) return;
  const t = now(), on = t < sim.signalUntil, base = hexToRgb(sim.color), odd = sim.kind === "done" ? oddGreen(sim.color) : oddBlue(sim.color);
  gl.uniform1f(uni.iTime, t); gl.uniform1f(uni.iTimeCursorChange, sim.change);
  gl.uniform4f(uni.iCurrentCursor, ...rect(ROW, sim.cur)); gl.uniform4f(uni.iPreviousCursor, ...rect(ROW + sim.prevRow, sim.prev));
  gl.uniform4f(uni.iCurrentCursorColor, ...(on ? odd : base), 1); gl.uniform4f(uni.iPreviousCursorColor, ...(sim.signalPrev ? odd : base), 1);
  gl.drawArrays(gl.TRIANGLES, 0, 3);
  const err = $("#previewErr"); if (err) { err.hidden = !previewError; if (previewError) err.textContent = t("compileErr") + previewError; }
}
requestAnimationFrame(frame);
let typing = null;
function moveCursor(col, row = 0) { sim.prev = sim.cur; sim.prevRow = row; sim.cur = col; sim.change = now(); lastAction = sim.change; drawTerm(); applyZoom(); }
function endSignal() { sim.signalPrev = true; sim.change = now(); sim.signalUntil = 0; later(() => { sim.signalPrev = false; }, 50); }
const MAX_INPUT = Math.floor((W - 2 * PADX) / CW) - 4;
// Typed or picked text goes in at once: one cursor move for a whole phrase, like the terminal.
function insertText(text) {
  clearTimeout(typing);
  for (const ch of Array.from(text.replace(/[\r\n]/g, ""))) { if (cellsOf(sim.input + ch) > MAX_INPUT) break; sim.input += ch; }
  moveCursor(2 + cellsOf(sim.input));
}
// The preview's Enter and done always start from the plain color (a real second signal while
// one is on also flips the red value's lowest bit; see `cursor-fx signal`).
const scenarios = {
  type() { clearTimeout(typing); const text = "make the cursor glow"; let i = 0; sim.input = ""; moveCursor(2); const step = () => { if (i >= text.length) return; sim.input += text[i++]; moveCursor(2 + cellsOf(sim.input)); typing = later(step, 130); }; typing = later(step, 130); },
  enter() { clearTimeout(typing); if (!sim.input) sim.input = "make it glow"; sim.sent = sim.input; sim.input = ""; moveCursor(2); later(() => { sim.kind = "enter"; sim.signalPrev = false; sim.signalUntil = now() + 1.9; sim.change = now(); sim.prev = sim.cur; sim.prevRow = 0; later(endSignal, 1900); }, 60); },
  done() { clearTimeout(typing); sim.kind = "done"; sim.signalPrev = false; sim.signalUntil = now() + 1.9; sim.change = now(); lastAction = sim.change; sim.prev = sim.cur; sim.prevRow = 0; later(endSignal, 1900); },
  deleteAll() { clearTimeout(typing); if (!sim.input) { sim.input = "delete all of this text"; moveCursor(2 + cellsOf(sim.input)); later(() => { sim.input = ""; moveCursor(2); }, 400); } else { sim.input = ""; moveCursor(2); } }
};
// Typing straight into the preview (it has focus): letters, Backspace, Cmd/Ctrl/Alt+Backspace, Enter.
// Keys an input method is using (pinyin and the like) are left to it: its text arrives at compositionend.
function previewKey(ev) {
  if (ev.isComposing || ev.keyCode === 229) return;
  if (ev.key === "Escape") { ev.currentTarget.blur(); return; }
  if (ev.key === "Enter") { ev.preventDefault(); scenarios.enter(); return; }
  if (ev.key === "Backspace") {
    ev.preventDefault(); clearTimeout(typing);
    if (ev.metaKey || ev.ctrlKey || ev.altKey) { if (sim.input) { sim.input = ""; moveCursor(2); } }
    else if (sim.input) { sim.input = Array.from(sim.input).slice(0, -1).join(""); moveCursor(2 + cellsOf(sim.input)); }
    return;
  }
  if (ev.key.length === 1 && !ev.metaKey && !ev.ctrlKey) {
    ev.preventDefault(); clearTimeout(typing);
    insertText(ev.key);
  }
}
// Zoom: the preview scaled up around the cursor (the canvas has more pixels than it is shown with).
function applyZoom() {
  const box = $("#previewBox"), z = box && box.querySelector(".pvzoom"); if (!z) return;
  const bw = box.clientWidth, k = bw / W, bh = H * k;
  const px = (PADX + (sim.cur + 0.5) * CW) * k, py = (PADY + (ROW + 0.5) * CH) * k;
  const tx = Math.min(0, Math.max(bw - bw * ZOOM, bw / 2 - px * ZOOM)), ty = Math.min(0, Math.max(bh - bh * ZOOM, bh / 2 - py * ZOOM));
  z.style.transform = ZOOM === 1 ? "none" : `translate(${tx}px, ${ty}px) scale(${ZOOM})`;
  // The (invisible) text field sits on the cursor, so the input method's candidates show next to it.
  const ime = box.querySelector("#ime");
  if (ime) { const zx = ZOOM === 1 ? 0 : tx, zy = ZOOM === 1 ? 0 : ty; ime.style.left = `${zx + (PADX + sim.cur * CW) * k * ZOOM}px`; ime.style.top = `${zy + (PADY + ROW * CH) * k * ZOOM}px`; ime.style.height = `${CH * k * ZOOM}px`; }
}
window.addEventListener("resize", applyZoom);

// --- the page ---------------------------------------------------------------
let selected = STATE.active !== "off" && STATE.effects.some(e => e.name === STATE.active) ? STATE.active : (STATE.effects[0] || {}).name;
const effectOf = name => STATE.effects.find(e => e.name === name);
const cap = s => s && LANG === "en" ? s[0].toUpperCase() + s.slice(1) : s;
// What an effect is, in a few words (an effect added later: its description up to the first pause).
const TAGLINES = {
  en: { cyber: "Data rain, decrypting text", lightning: "Arcs of current", glitch: "A corrupted signal", neon: "A glowing pink tube",
        phosphor: "Green CRT glow", embers: "A burning coal", shockwave: "Ripples that bend text", katana: "A polished steel blade",
        teleport: "A transporter beam", fireworks: "Sparkler and fireworks", aurora: "Northern lights", mecha: "Robot armor", hologram: "A cyan projection" },
  zh: { cyber: "数据雨，逐字解密", lightning: "电弧与闪电", glitch: "受损的信号", neon: "粉色霓虹灯管", phosphor: "绿色 CRT 荧光", embers: "燃烧的炭火",
        shockwave: "让文字弯曲的波纹", katana: "抛光的钢刃", teleport: "传送光束", fireworks: "手持烟花与烟火", aurora: "北极光", mecha: "机甲装甲", hologram: "青色全息投影" } };
const taglineOf = e => TAGLINES[LANG][e.name] || cap((descOf(e) || "").split(/[;；。:：(（]/)[0].trim());
function renderList() {
  const el = $("#effects"); el.innerHTML = "";
  for (const e of STATE.effects) {
    const b = document.createElement("button"); b.type = "button"; b.className = "effect" + (e.name === selected ? " selected" : "");
