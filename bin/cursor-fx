const TOKEN = "__TOKEN__";
let STATE = __STATE__;
const $ = s => document.querySelector(s);
const toastEl = $("#toast"); let toastTimer;
function toast(msg) { toastEl.textContent = msg; toastEl.classList.add("show"); clearTimeout(toastTimer); toastTimer = setTimeout(() => toastEl.classList.remove("show"), 2600); }
async function post(path, body) {
  const r = await fetch(path, { method: "POST", headers: { "Content-Type": "application/json", "X-Token": TOKEN }, body: JSON.stringify(body || {}) });
  const data = await r.json();
  if (!r.ok || data.error) throw new Error(data.error || r.statusText);
  return data;
}
const hexToRgb = h => [1, 3, 5].map(i => parseInt(h.slice(i, i + 2), 16) / 255);
const rgbToHex = c => "#" + c.map(v => Math.round(Math.max(0, Math.min(1, v)) * 255).toString(16).padStart(2, "0")).join("");
function luminance(h) { const f = v => v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); const [r, g, b] = hexToRgb(h).map(f); return 0.2126 * r + 0.7152 * g + 0.0722 * b; }
function contrast(a, b) { const x = luminance(a), y = luminance(b); return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05); }
const fmtNum = v => { let s = Number(v).toFixed(4).replace(/0+$/, ""); return s.endsWith(".") ? s + "0" : s; };
function glsl(type, value) {
  if (type === "bool") return value ? "true" : "false";
  if (type === "int") return String(Math.round(value));
  if (type === "float") return fmtNum(value);
  return type + "(" + value.map(fmtNum).join(", ") + ")";
}
function parseValue(type, text) {
  if (type === "bool") return text.trim() === "true";
  if (type === "float" || type === "int") return Number(text);
  const m = text.match(/\(([^)]*)\)/); return m ? m[1].split(",").map(Number) : [0, 0, 0];
}
function patchSource(src, name, source) {
  return src.replace(new RegExp("^(const\\s+(?:bool|float|int|vec2|vec3)\\s+" + name + "\\s*=\\s*)([^;]+?)(\\s*;.*)$", "m"), (m, a, b, c) => a + source + c);
}
const humanize = n => n.toLowerCase().replace(/_/g, " ").replace(/^./, c => c.toUpperCase());

