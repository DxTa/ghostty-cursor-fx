#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Switch Ghostty cursor effects.

  cursor-fx            list the effects, the active one marked
  cursor-fx <name>     switch to an effect (e.g. lightning, glitch)
  cursor-fx off        plain cursor, no effect
  cursor-fx enter off  pause the Enter effects (typing effects stay)
  cursor-fx enter on   resume them
  cursor-fx jumps off  no effect when the cursor jumps along a line (delete-all, Home...)
  cursor-fx jumps on   ...or play the effect (edits JUMP_EFFECTS in every shader and reloads)
  cursor-fx idle off   no small animations between keystrokes (crackle, breath, ping...):
  cursor-fx idle on    a calmer screen (it saves little battery: Ghostty keeps redrawing
                       while any effect is on; `cursor-fx off` is the power saver)
  cursor-fx edit       open the settings panel in your browser: pick the effect, set its
                       cursor color and every setting of its shader with a live preview;
                       changes apply to Ghostty as you make them (--no-open: just print the URL)
  cursor-fx signal     mark "Enter pressed" for the effects (run by the Claude Code
                       UserPromptSubmit hook and zsh's preexec; --tty PATH to choose the tab)
  cursor-fx signal done   mark "the answer arrived" (Claude Code's Stop hook; zsh after a
                       command that took more than a few seconds)

Each effect is a preset in ~/.config/ghostty/cursor-effects/<name>.conf that sets
the cursor color and its shader. Switching makes a savepoint, rewrites the one
`config-file = cursor-effects/...` line in the Ghostty config, validates it, and
reloads Ghostty (SIGUSR2, the same as Command+Shift+,) so the effect starts at once.

Works on macOS and Linux (Ghostty has no Windows version): the config lives in
$XDG_CONFIG_HOME/ghostty or ~/.config/ghostty on both, and both the macOS app and
the Linux GTK app reload on SIGUSR2.

Test hooks: CURSOR_FX_CONFIG (config path; also skips the reload, since the running
Ghostty doesn't read that file), CURSOR_FX_SAVEPOINTS, CURSOR_FX_TTY.
"""
import contextlib
import hashlib
import io
import json
import os
import re
import secrets
import shlex
import shutil
import signal
import subprocess
import sys
import threading
import time
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

def find_config():
    """The Ghostty config file: the first existing config or config.ghostty in the Ghostty folder
    under $XDG_CONFIG_HOME (default ~/.config) or in Ghostty's macOS folder. Symlinks are resolved,
    so the presets and shaders sit next to the real file."""
    xdg = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "ghostty")
    mac = os.path.expanduser("~/Library/Application Support/com.mitchellh.ghostty")
    for folder in (xdg, mac):
        for name in ("config", "config.ghostty"):
            if os.path.exists(os.path.join(folder, name)):
                return os.path.realpath(os.path.join(folder, name))
    return os.path.join(xdg, "config")


CONFIG = os.environ.get("CURSOR_FX_CONFIG") or find_config()
PRESETS = os.path.join(os.path.dirname(CONFIG), "cursor-effects")
THEMES = os.path.join(os.path.dirname(CONFIG), "themes")
SAVEPOINTS = os.environ.get("CURSOR_FX_SAVEPOINTS", os.path.expanduser("~/ghostty-savepoints"))
CACHE = os.environ.get("CURSOR_FX_CACHE", os.path.expanduser("~/.cache/cursor-fx"))
SIGNAL_TIME = 1.9  # seconds the Enter signal stays on (longer than the longest Enter effect)
GHOSTTY_APP = "/Applications/Ghostty.app/Contents/MacOS/ghostty"  # macOS; Linux has `ghostty` on PATH
GHOSTTY = GHOSTTY_APP if os.path.isfile(GHOSTTY_APP) else shutil.which("ghostty")
SHADERS = os.path.join(os.path.dirname(CONFIG), "shaders")
# The on/off settings every shader shares, switched for all of them at once.
FLAGS = {"jumps": ("JUMP_EFFECTS", "Jump effects"), "idle": ("IDLE_EFFECTS", "Idle animations")}


def flag_line(flag):
    return re.compile(r'^(const\s+bool\s+' + FLAGS[flag][0] + r'\s*=\s*)(true|false)(\s*;.*)$')

MARKER = "# Cursor effect preset"
MARKER_LINE = MARKER + " from cursor-effects/ (switch with `cursor-fx <name>`, list with `cursor-fx`).\n"
INCLUDE = re.compile(r'^\s*config-file\s*=\s*"?\??cursor-effects/([^"/]+)\.conf"?\s*$')
# `cursor-fx enter off` leaves this comment in the config; `enter on` removes it.
ENTER_OFF = re.compile(r'^\s*#\s*cursor-fx-enter\s*=\s*off\b')
ENTER_OFF_LINE = "# cursor-fx-enter = off (Enter effects paused; `cursor-fx enter on` resumes them)\n"
SETTING = re.compile(r'^\s*([a-z-]+)\s*=\s*(.*?)\s*$')

ROLLBACK = """#!/bin/bash
set -euo pipefail

savepoint_dir="$(cd -- "$(dirname -- "$0")" && pwd)"
(
  cd "$savepoint_dir"
  shasum -a 256 -c SHA256SUMS >/dev/null
)

rescue_dir="$(mktemp -d "$savepoint_dir/pre-rollback.XXXXXX")"
cp -p @CONFIG@ "$rescue_dir/ghostty-config"
cp -p "$savepoint_dir/ghostty-config" @CONFIG@

echo "已恢复 cursor-fx 切换前的 Ghostty 配置（光标特效：@BEFORE@）。"
echo "回滚前的配置另存于：$rescue_dir"
echo "请在 Ghostty 按 Command+Shift+, 重新加载。"
"""


def settings(path):
    """The key = value lines of a Ghostty config file, as a dict (last one wins)."""
    out = {}
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                m = SETTING.match(line)
                if m and not line.lstrip().startswith("#"):
                    out[m.group(1)] = m.group(2).strip('"')
    except OSError:
        pass
    return out


# The order effects are listed in (CLI and panel); any other preset follows, by name.
ORDER = ["cyber", "lightning", "glitch", "neon", "phosphor", "embers", "shockwave", "katana",
         "teleport", "fireworks", "aurora", "mecha", "hologram"]


def presets():
    """(name, description) for every preset file, in ORDER, then the rest by name."""
    found = []
    if os.path.isdir(PRESETS):
        entries = sorted(os.listdir(PRESETS), key=lambda e: (ORDER.index(e[:-5]) if e[:-5] in ORDER else len(ORDER), e))
        for entry in entries:
            if not entry.endswith(".conf"):
                continue
            desc = ""
            with open(os.path.join(PRESETS, entry), encoding="utf-8") as f:
                for line in f:
                    if line.startswith("#"):
                        desc = line.lstrip("# ").strip()
                        desc = desc.split(": ", 1)[1] if ": " in desc else desc
                        break
            found.append((entry[:-5], desc))
    return found


def active(lines):
    for line in lines:
        m = INCLUDE.match(line)
        if m:
            return m.group(1)
    return None


def enter_enabled(lines):
    return not any(ENTER_OFF.match(line) for line in lines)


def set_enter(state):
    """Pause or resume the Enter effects (a comment line in the config; no reload needed,
    since `cursor-fx signal` checks it each time)."""
    with open(CONFIG, encoding="utf-8") as f:
        lines = f.readlines()
    now = enter_enabled(lines)
    if state is None:
        print(f"Enter effects: {'on' if now else 'off'} (cursor-fx enter on|off)")
        return 0
    if state not in ("on", "off"):
        print("Usage: cursor-fx enter on|off")
        return 1
    if (state == "on") == now:
        print(f"Enter effects are already {state}.")
        return 0
    if state == "on":
        out = [line for line in lines if not ENTER_OFF.match(line)]
    else:
        out = list(lines)
        at = next((i for i, line in enumerate(out) if INCLUDE.match(line) or line.startswith(MARKER)), None)
        if at is None:
            if out and not out[-1].endswith("\n"):
                out[-1] += "\n"
            out.append(ENTER_OFF_LINE)
        else:
            out.insert(at + 1, ENTER_OFF_LINE)
    with open(CONFIG, "w", encoding="utf-8") as f:
        f.writelines(out)
    print(f"Enter effects: {state}" + (" (typing effects stay; sends and commands do nothing extra)" if state == "off" else ""))
    return 0


def savepoint(label, before):
    stamp = time.strftime("%Y%m%d-%H%M%S")
    sp = os.path.join(SAVEPOINTS, f"{stamp}-before-{label}")
    n = 2
    while os.path.exists(sp):
        sp = os.path.join(SAVEPOINTS, f"{stamp}-{n}-before-{label}")
        n += 1
    os.makedirs(sp)
    copy = os.path.join(sp, "ghostty-config")
    shutil.copy2(CONFIG, copy)
    with open(copy, "rb") as f:
        digest = hashlib.sha256(f.read()).hexdigest()
    with open(os.path.join(sp, "SHA256SUMS"), "w", encoding="utf-8") as f:
        f.write(f"{digest}  ghostty-config\n")
    rollback = os.path.join(sp, "rollback.sh")
    with open(rollback, "w", encoding="utf-8") as f:
        f.write(ROLLBACK.replace("@CONFIG@", shlex.quote(CONFIG)).replace("@BEFORE@", before))
    os.chmod(rollback, 0o755)
    return sp


def reset_cursor_color():
    """Drop a cursor color this tab was given by escape code (OSC 112), so it follows
    the config again. Earlier versions of cursor-fx set one with OSC 12, and such an
    override survives config reloads."""
    tty = os.environ.get("CURSOR_FX_TTY")
    if not tty:
        if os.environ.get("TMUX") or not sys.stdout.isatty():
            return
        tty = "/dev/tty"
    try:
        with open(tty, "w") as f:
            f.write("\033]112\007")
    except OSError:
        pass


def ghostty_pids():
    """The running Ghostty app: the one this command runs in, else any Ghostty app process."""
    pid = os.getpid()
    while pid > 1:
        out = subprocess.run(["ps", "-o", "ppid=,comm=", "-p", str(pid)],
                             capture_output=True, text=True).stdout.strip()
        if not out:
            break
        ppid, comm = out.split(None, 1)
        if comm == GHOSTTY or os.path.basename(comm) == "ghostty":  # macOS shows the full path, Linux the name
            return [pid]
        pid = int(ppid)
    if GHOSTTY == GHOSTTY_APP:
        found = subprocess.run(["pgrep", "-f", GHOSTTY], capture_output=True, text=True).stdout.split()
    else:
        found = subprocess.run(["pgrep", "-x", "ghostty"], capture_output=True, text=True).stdout.split()
    apps = []
    for p in found:
        args = subprocess.run(["ps", "-o", "args=", "-p", p], capture_output=True, text=True).stdout.strip()
        if " +" not in args:  # skip CLI runs like `ghostty +show-config`
            apps.append(int(p))
    return apps


def reload_ghostty():
    """Ask Ghostty to reload its config (it handles SIGUSR2 like Command+Shift+,)."""
    if "CURSOR_FX_CONFIG" in os.environ:
        return False
    sent = False
    for pid in ghostty_pids():
        try:
            os.kill(pid, signal.SIGUSR2)
            sent = True
        except OSError:
            pass
    return sent


def list_effects():
    with open(CONFIG, encoding="utf-8") as f:
        lines = f.readlines()
    now = active(lines)
    found = presets()
    width = max([len(name) for name, _ in found] + [3])
    print("Cursor effects (switch with: cursor-fx <name>):")
    for name, desc in found + [("off", "plain cursor, no effect")]:
        mark = "●" if name == (now or "off") else " "
        print(f"  {mark} {name.ljust(width)}  {desc}")
    print(f"Enter effects: {'on' if enter_enabled(lines) else 'off'} (cursor-fx enter on|off)")
    for flag in FLAGS:
        print(f"{FLAGS[flag][1]}: {flag_state(flag)} (cursor-fx {flag} on|off)")
    return 0


def flag_lines(flag):
    """(shader path, lines, index of the flag's line) for every shader that has it."""
    found = []
    pattern = flag_line(flag)
    if os.path.isdir(SHADERS):
        for entry in sorted(os.listdir(SHADERS)):
            if not entry.endswith(".glsl"):
                continue
            path = os.path.join(SHADERS, entry)
            with open(path, encoding="utf-8") as f:
                lines = f.readlines()
            at = next((i for i, line in enumerate(lines) if pattern.match(line)), None)
            if at is not None:
                found.append((path, lines, at))
    return found


def flag_state(flag):
    pattern = flag_line(flag)
    states = {pattern.match(lines[at]).group(2) for _, lines, at in flag_lines(flag)}
    if not states:
        return "n/a"
    return {"true": "on", "false": "off"}[states.pop()] if len(states) == 1 else "mixed"


def set_flag(flag, state):
    """Turn a shared on/off setting (`cursor-fx jumps`, `cursor-fx idle`) on or off in every shader."""
    label = FLAGS[flag][1]
    if state is None:
        print(f"{label}: {flag_state(flag)} (cursor-fx {flag} on|off)")
        return 0
    if state not in ("on", "off"):
        print(f"Usage: cursor-fx {flag} on|off")
        return 1
    value = "true" if state == "on" else "false"
    pattern = flag_line(flag)
    changed = 0
    for path, lines, at in flag_lines(flag):
        m = pattern.match(lines[at])
        if m.group(2) == value:
            continue
        lines[at] = m.group(1) + value + m.group(3) + "\n"
        with open(path, "w", encoding="utf-8") as f:
            f.writelines(lines)
        changed += 1
    print(f"{label}: {state} ({changed} shader{'s' if changed != 1 else ''} changed)")
    if changed and reload_ghostty():
        print("Ghostty reloaded.")
    elif changed:
        print("Press Command+Shift+, in Ghostty to apply it.")
    return 0


def switch(name):
    names = [n for n, _ in presets()]
    if name != "off" and name not in names:
        print(f"No cursor effect named '{name}'. Choose one of: {', '.join(names + ['off'])}")
        return 1
    with open(CONFIG, encoding="utf-8") as f:
        lines = f.readlines()
    before = active(lines) or "off"
    if before == name:
        # Still reload, so edits to the effect's shader file take effect.
        reloaded = reload_ghostty()
        print(f"Cursor effect is already: {name}" + (" (reloaded Ghostty)" if reloaded else ""))
        return 0

    # A preset must point at a shader that exists, or Ghostty silently runs without it.
    if name != "off":
        shader = settings(os.path.join(PRESETS, f"{name}.conf")).get("custom-shader")
        if shader and not os.path.isfile(os.path.join(PRESETS, os.path.expanduser(shader))):
            print(f"The '{name}' preset points at a shader that doesn't exist: {shader}")
            return 1

    out = [line for line in lines if not INCLUDE.match(line)]
    include = f"config-file = cursor-effects/{name}.conf\n"
    at = next((i for i, line in enumerate(out) if line.startswith(MARKER)), None)
    if at is None:
        if out and not out[-1].endswith("\n"):
            out[-1] += "\n"
        out.append(MARKER_LINE)
        at = len(out) - 1
    if name != "off":
        out.insert(at + 1, include)

    sp = savepoint(f"cursor-fx-{name}", before)
    with open(CONFIG, "w", encoding="utf-8") as f:  # in place, so a symlinked config stays a symlink
        f.writelines(out)
    check = subprocess.run([GHOSTTY, "+validate-config", f"--config-file={CONFIG}"],
                           capture_output=True, text=True) if GHOSTTY else None
    if check is None:
        print("Note: `ghostty` wasn't found on PATH, so the config wasn't validated.")
    elif check.returncode != 0:
        shutil.copy2(os.path.join(sp, "ghostty-config"), CONFIG)
        print("Ghostty rejected the new config, so nothing was changed:")
        print(check.stdout + check.stderr)
        return 1

    color = preset_color(name)
    reset_cursor_color()

    print(f"Cursor effect: {name}" + (f" (cursor {color})" if color else ""))
    if color and len(color.lstrip("#")) == 6 and int(color.lstrip("#")[2:], 16) & 0x0101:
        print("Note: this cursor color's green or blue value is odd; the Enter/done effects need both even (e.g. ...fe, not ...ff).")
    if reload_ghostty():
        print("Ghostty reloaded: the effect is live in every window.")
    else:
        print("Press Command+Shift+, in Ghostty to apply it.")
    print(f"Undo: bash {shlex.quote(os.path.join(sp, 'rollback.sh'))}")
    return 0


def preset_color(name):
    """The cursor color a preset sets (for "off", the config's or the theme's)."""
    if name == "off":
        theme = settings(CONFIG).get("theme", "")
        return settings(CONFIG).get("cursor-color") or settings(os.path.join(THEMES, theme)).get("cursor-color")
    return settings(os.path.join(PRESETS, f"{name}.conf")).get("cursor-color")


def own_tty():
    """The terminal this command runs in: the first ancestor process that has one."""
    pid = os.getpid()
    while pid > 1:
        out = subprocess.run(["ps", "-o", "ppid=,tty=", "-p", str(pid)],
                             capture_output=True, text=True).stdout.split()
        if len(out) < 2:
            return None
        if out[1] not in ("??", "-"):
            return "/dev/" + out[1]
        pid = int(out[0])
    return None


def signal_enter(argv):
    """Tell the cursor effects that Enter was pressed (a prompt sent, a command run),
    or, with `done`, that the answer arrived (Claude finished, a long command ended).

    Sets the tab's cursor color to the preset's color with the lowest bit of its blue
    value set for Enter, or of its green value for done (invisible to the eye); the
    shaders read those bits, and SIGNAL_TIME later the color is reset. Prints
    nothing: Claude Code adds a UserPromptSubmit hook's output to the prompt.
    """
    tty = argv[argv.index("--tty") + 1] if "--tty" in argv else own_tty()
    kind = "done" if "done" in argv[2:] else "enter"
    with open(CONFIG, encoding="utf-8") as f:
        lines = f.readlines()
    if not enter_enabled(lines):
        return 0
    name = active(lines) or "off"
    color = (preset_color(name) or "").lstrip("#")
    if not tty or len(color) != 6:
        return 0
    r, g, b = int(color[:2], 16), int(color[2:4], 16), int(color[4:], 16)
    g, b = (g & ~1, b | 1) if kind == "enter" else (g | 1, b & ~1)
    os.makedirs(CACHE, exist_ok=True)
    marker = os.path.join(CACHE, "signal-" + os.path.basename(tty))
    # Every signal flips the red value's lowest bit (invisible too), so a new one while the
    # last is still on is a change of color the shaders see. Before, they took any cursor
    # jump during a signal for a new one, and a Tab completion replayed the Enter effect.
    try:
        with open(marker, encoding="utf-8") as f:
            parity = 1 - int(f.read().rsplit(":", 1)[1])
    except (OSError, ValueError, IndexError):
        parity = 1 - (r & 1)
    r = (r & ~1) | parity
    signal_color = f"{r:02x}{g:02x}{b:02x}"
    token = f"{time.time():.6f}:{parity}"
    with open(marker, "w", encoding="utf-8") as f:
        f.write(token)
    fd = os.open(tty, os.O_WRONLY | os.O_NONBLOCK)  # never hang on a tab that's gone
    try:
        os.write(fd, f"\033]12;#{signal_color}\007".encode())
    finally:
        os.close(fd)
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "signal-off", tty, marker, token],
                     start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    log = os.path.join(CACHE, "signal.log")
    mode = "w" if os.path.exists(log) and os.path.getsize(log) > 100_000 else "a"
    with open(log, mode, encoding="utf-8") as f:
        f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {tty} {name} {kind} #{signal_color}\n")
    return 0


def signal_off(tty, marker, token):
    """Reset the cursor color after SIGNAL_TIME, unless a newer signal took over."""
    time.sleep(SIGNAL_TIME)
    try:
        with open(marker, encoding="utf-8") as f:
            if f.read() != token:
                return 0
        with open(tty, "w") as f:
            f.write("\033]112\007")
        os.remove(marker)
    except OSError:
        pass
    return 0


# --- the settings panel (`cursor-fx edit`) -----------------------------------
# Every shader keeps its settings as `const <type> NAME = value;  // what it does`
# lines at the top; the panel reads them, shows a control per line, writes the
# value back into the file and reloads Ghostty. The preview in the page runs the
# very same shader in WebGL.

SETTING_LINE = re.compile(r'^(const\s+(bool|float|int|vec2|vec3)\s+([A-Z][A-Z0-9_]*)\s*=\s*)([^;]+?)(\s*;.*)$')
PRESET_COLOR = re.compile(r'^(\s*cursor-color\s*=\s*)(\S+)(.*)$')
PRESET_BLINK = re.compile(r'^(\s*cursor-style-blink\s*=\s*)(\S+)(.*)$')
PALETTE_LINE = re.compile(r'^\s*palette\s*=\s*(\d+)\s*=\s*(#?[0-9a-fA-F]{6})')


def shader_settings(path):
    """The `const` lines of a shader, in file order: [{name, type, value, comment, section, group}].
    Lines after a `// --- fine-tuning ---` marker are the "fine" section (folded away in the panel);
    a `// -- Name` line starts a group (a heading in the panel) until the next one."""
    out = []
    section, group = "main", None
    with open(path, encoding="utf-8") as f:
        for line in f:
            if re.match(r"^\s*//\s*---\s*fine", line):
                section, group = "fine", None
                continue
            g = re.match(r"^\s*//\s*--\s+(\S.*?)\s*$", line)
            if g:
                group = g.group(1)
                continue
            m = SETTING_LINE.match(line.rstrip("\n"))
            if not m:
                continue
            tail = m.group(5)
            comment = tail.split("//", 1)[1].strip() if "//" in tail else ""
            out.append({"name": m.group(3), "type": m.group(2), "value": m.group(4).strip(),
                        "comment": comment, "section": section, "group": group})
    return out


def glsl_value(kind, value):
    """`value` from the page (bool, number or list) as GLSL source for a `const` of
    this type, or None if it doesn't fit."""
    def num(v):
        v = float(v)
        if v != v or v in (float("inf"), float("-inf")):
            raise ValueError(v)
        s = f"{v:.4f}".rstrip("0")
        return s + "0" if s.endswith(".") else s
    try:
        if kind == "bool":
            return "true" if value else "false"
        if kind == "float":
            return num(value)
        if kind == "int":
            return str(int(value))
        n = {"vec2": 2, "vec3": 3}[kind]
        parts = [num(v) for v in value]
        if len(parts) != n:
            return None
        return f"{kind}({', '.join(parts)})"
    except (TypeError, ValueError, KeyError):
        return None


def set_shader_value(path, name, source):
    """Rewrite one `const` line's value (as GLSL source text). False if there is no such line."""
    with open(path, encoding="utf-8") as f:
        lines = f.readlines()
    for i, line in enumerate(lines):
        m = SETTING_LINE.match(line.rstrip("\n"))
        if m and m.group(3) == name:
            lines[i] = m.group(1) + source + m.group(5) + "\n"
            with open(path, "w", encoding="utf-8") as f:
                f.writelines(lines)
            return True
    return False


def set_preset_color(name, color):
    """Write a preset's `cursor-color` (color as rrggbb). False if the preset has none."""
    path = os.path.join(PRESETS, f"{name}.conf")
    with open(path, encoding="utf-8") as f:
        lines = f.readlines()
    for i, line in enumerate(lines):
        m = PRESET_COLOR.match(line.rstrip("\n"))
        if m:
            lines[i] = m.group(1) + "#" + color + m.group(3) + "\n"
            with open(path, "w", encoding="utf-8") as f:
                f.writelines(lines)
            return True
    return False


def preset_blink(name):
    """Whether the cursor blinks with a preset: its own `cursor-style-blink`, else the main config's (Ghostty's default: on)."""
    own = settings(os.path.join(PRESETS, f"{name}.conf")).get("cursor-style-blink")
    if own is None:
        own = settings(CONFIG).get("cursor-style-blink", "true")
    return own.strip().lower() != "false"


def set_preset_blink(name, on):
    """Write a preset's `cursor-style-blink` (a preset's settings override the main config's), after its cursor-color line if it has none yet.
    None removes the line, so the preset follows the main config again."""
    path = os.path.join(PRESETS, f"{name}.conf")
    with open(path, encoding="utf-8") as f:
        lines = f.readlines()
    if on is None:
        lines = [line for line in lines if not PRESET_BLINK.match(line.rstrip("\n"))]
        with open(path, "w", encoding="utf-8") as f:
            f.writelines(lines)
        return
    value = "true" if on else "false"
    for i, line in enumerate(lines):
        m = PRESET_BLINK.match(line.rstrip("\n"))
        if m:
            lines[i] = m.group(1) + value + m.group(3) + "\n"
            break
    else:
        at = next((i + 1 for i, line in enumerate(lines) if PRESET_COLOR.match(line.rstrip("\n"))), len(lines))
        lines.insert(at, f"cursor-style-blink = {value}\n")
    with open(path, "w", encoding="utf-8") as f:
        f.writelines(lines)


def preset_shader(name):
    """Path of the shader file a preset points at, or None."""
    shader = settings(os.path.join(PRESETS, f"{name}.conf")).get("custom-shader")
    if not shader:
        return None
    path = os.path.join(PRESETS, os.path.expanduser(shader))
    return path if os.path.isfile(path) else None


def terminal_colors():
    """Background, text, cursor-text and palette the preview draws with: the config's
    own values, else the theme file's, else Ghostty-like defaults."""
    conf = settings(CONFIG)
    theme = conf.get("theme", "")
    colors = {"background": "#1e1e2e", "foreground": "#cdd6f4", "cursorText": "", "palette": [""] * 16}
    for path in (os.path.join(THEMES, theme), CONFIG):
        try:
            with open(path, encoding="utf-8") as f:
                for line in f:
                    m = PALETTE_LINE.match(line)
                    if m and int(m.group(1)) < 16:
                        colors["palette"][int(m.group(1))] = "#" + m.group(2).lstrip("#")
        except OSError:
            pass
        values = settings(path)
        for key, mine in (("background", "background"), ("foreground", "foreground"), ("cursor-text", "cursorText")):
            if values.get(key, "").startswith("#"):
                colors[mine] = values[key]
    return colors


def savepoint_effects(label):
    """Copy every shader and preset into a savepoint with a rollback script."""
    stamp = time.strftime("%Y%m%d-%H%M%S")
    sp = os.path.join(SAVEPOINTS, f"{stamp}-before-{label}")
    n = 2
    while os.path.exists(sp):
        sp = os.path.join(SAVEPOINTS, f"{stamp}-{n}-before-{label}")
        n += 1
    os.makedirs(os.path.join(sp, "shaders"))
    os.makedirs(os.path.join(sp, "cursor-effects"))
    sums = []
    for src, sub, ext in ((SHADERS, "shaders", ".glsl"), (PRESETS, "cursor-effects", ".conf")):
        for entry in sorted(os.listdir(src)):
            if entry.endswith(ext):
                shutil.copy2(os.path.join(src, entry), os.path.join(sp, sub, entry))
                with open(os.path.join(src, entry), "rb") as f:
                    sums.append(f"{hashlib.sha256(f.read()).hexdigest()}  {sub}/{entry}\n")
    with open(os.path.join(sp, "SHA256SUMS"), "w", encoding="utf-8") as f:
        f.writelines(sums)
    script = f"""#!/bin/bash
set -euo pipefail
savepoint_dir="$(cd -- "$(dirname -- "$0")" && pwd)"
( cd "$savepoint_dir" && shasum -a 256 -c SHA256SUMS >/dev/null )
rescue_dir="$(mktemp -d "$savepoint_dir/pre-rollback.XXXXXX")"
mkdir -p "$rescue_dir/shaders" "$rescue_dir/cursor-effects"
for f in "$savepoint_dir"/shaders/*.glsl; do
  name="$(basename "$f")"
  [ -f {shlex.quote(SHADERS)}/"$name" ] && cp -p {shlex.quote(SHADERS)}/"$name" "$rescue_dir/shaders/"
  cp -p "$f" {shlex.quote(SHADERS)}/"$name"
done
for f in "$savepoint_dir"/cursor-effects/*.conf; do
  name="$(basename "$f")"
  [ -f {shlex.quote(PRESETS)}/"$name" ] && cp -p {shlex.quote(PRESETS)}/"$name" "$rescue_dir/cursor-effects/"
  cp -p "$f" {shlex.quote(PRESETS)}/"$name"
done
echo "Restored every cursor effect shader and preset from before {label}. The files from before this rollback are in: $rescue_dir"
echo "Run cursor-fx <name of the active effect> to reload Ghostty."
"""
    with open(os.path.join(sp, "rollback.sh"), "w", encoding="utf-8") as f:
        f.write(script)
    os.chmod(os.path.join(sp, "rollback.sh"), 0o755)
    return sp


def system_language():
    """'zh' when the system's first preferred language is Chinese, else 'en'
    (macOS: AppleLanguages; elsewhere LC_ALL / LC_MESSAGES / LANG)."""
    langs = []
    if sys.platform == "darwin":
        try:
            out = subprocess.run(["defaults", "read", "-g", "AppleLanguages"], capture_output=True, text=True, timeout=3).stdout
            langs = re.findall(r'"?([A-Za-z]{2,3}(?:[-_][A-Za-z0-9]+)*)"?\s*[,)]', out)
        except (OSError, subprocess.SubprocessError):
            pass
    langs += [os.environ.get(k, "") for k in ("LC_ALL", "LC_MESSAGES", "LANG")]
    first = next((l for l in langs if l and l not in ("C", "POSIX")), "en")
    return "zh" if first.lower().startswith("zh") else "en"


def panel_state(session):
    with open(CONFIG, encoding="utf-8") as f:
        lines = f.readlines()
    effects = []
    for name, desc in presets():
        path = preset_shader(name)
        if not path:
            continue
        with open(path, encoding="utf-8") as f:
            source = f.read()
        effects.append({"name": name, "description": desc, "color": preset_color(name) or "", "blink": preset_blink(name),
                        "shader": os.path.basename(path), "settings": shader_settings(path), "source": source})
    return {"effects": effects, "active": active(lines) or "off", "enter": enter_enabled(lines),
            "jumps": flag_state("jumps"), "idle": flag_state("idle"), "colors": terminal_colors(),
            "yDown": sys.platform == "darwin", "sysLang": system_language(),
            "sharedFlags": [v[0] for v in FLAGS.values()],
            "savepoint": session.get("savepoint"), "original": session["original"]}


def quietly(func, *args):
    """Run a command function and return (its return code, what it printed)."""
    out = io.StringIO()
    with contextlib.redirect_stdout(out):
        code = func(*args)
    return code, out.getvalue().strip()


def make_panel_handler(session):
    def ensure_savepoint():
        if not session.get("savepoint"):
            session["savepoint"] = savepoint_effects("cursor-fx-edit")

    def schedule_reload():
        if session.get("timer"):
            session["timer"].cancel()
        session["timer"] = threading.Timer(0.3, reload_ghostty)
        session["timer"].daemon = True
        session["timer"].start()

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def reply(self, code, body, ctype="application/json; charset=utf-8"):
            data = body.encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            url = urlparse(self.path)
            if url.path == "/" and parse_qs(url.query).get("t", [""])[0] == session["token"]:
                session["last"] = time.time()
                state = json.dumps(panel_state(session)).replace("</", "<\\/")
                page = (PANEL_HTML.replace("__TOKEN__", session["token"]).replace("__STATE__", state)
                        .replace("__ZH__", json.dumps(PANEL_ZH, ensure_ascii=False).replace("</", "<\\/")))
                return self.reply(200, page, "text/html; charset=utf-8")
            if url.path == "/favicon.ico":
                return self.reply(204, "")
            self.reply(403, '{"error": "forbidden"}')

        def do_POST(self):
            if self.headers.get("X-Token") != session["token"]:
                return self.reply(403, '{"error": "forbidden"}')
            session["last"] = time.time()
            try:
                body = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)) or b"{}")
            except ValueError:
                return self.reply(400, '{"error": "bad request"}')
            path = urlparse(self.path).path
            effect = str(body.get("effect", ""))
            names = [n for n, _ in presets()]
            if path == "/quit":
                self.reply(200, '{"ok": true}')
                threading.Thread(target=session["server"].shutdown, daemon=True).start()
                return
            if path == "/state":
                return self.reply(200, json.dumps(panel_state(session)))
            if path == "/toggle":
                what, state = body.get("what"), "on" if body.get("on") else "off"
                if what == "enter":
                    _, message = quietly(set_enter, state)
                elif what in FLAGS:
                    _, message = quietly(set_flag, what, state)
                else:
                    return self.reply(400, '{"error": "unknown switch"}')
                return self.reply(200, json.dumps({"ok": True, "message": message}))
            if effect not in names:
                return self.reply(400, '{"error": "unknown effect"}')
            if path == "/activate":
                code, message = quietly(switch, effect)
                return self.reply(200, json.dumps({"ok": code == 0, "message": message}))
            shader = preset_shader(effect)
            if path == "/set":
                source = glsl_value(str(body.get("type")), body.get("value"))
                if source is None or not shader:
                    return self.reply(400, '{"error": "bad value"}')
                # A float that started above zero is a divisor somewhere; zero would make the shader flash.
                was = session["original"].get(effect, {}).get("settings", {}).get(str(body.get("name")), "")
                try:
                    if body.get("type") == "float" and float(was) > 0 and float(body.get("value")) <= 0:
                        return self.reply(400, '{"error": "must stay above zero"}')
                except (TypeError, ValueError):
                    pass
                ensure_savepoint()
                if not set_shader_value(shader, str(body.get("name")), source):
                    return self.reply(400, '{"error": "unknown setting"}')
                schedule_reload()
                return self.reply(200, json.dumps({"ok": True, "source": source, "savepoint": session["savepoint"]}))
            if path == "/color":
                color = str(body.get("color", "")).lstrip("#").lower()
                if not re.fullmatch(r"[0-9a-f]{6}", color):
                    return self.reply(400, '{"error": "bad color"}')
                color = f"{color[:2]}{int(color[2:4], 16) & ~1:02x}{int(color[4:], 16) & ~1:02x}"  # the signals need even green and blue
                ensure_savepoint()
                if not set_preset_color(effect, color):
                    return self.reply(400, '{"error": "preset has no cursor-color"}')
                schedule_reload()
                return self.reply(200, json.dumps({"ok": True, "color": "#" + color, "savepoint": session["savepoint"]}))
            if path == "/blink":
                ensure_savepoint()
                set_preset_blink(effect, bool(body.get("on")))
                schedule_reload()
                return self.reply(200, json.dumps({"ok": True, "blink": preset_blink(effect), "savepoint": session["savepoint"]}))
            if path == "/reset":
                original = session["original"].get(effect)
                if not original or not shader:
                    return self.reply(400, '{"error": "nothing to reset"}')
                ensure_savepoint()
                for name, value in original["settings"].items():
                    set_shader_value(shader, name, value)
                if original["color"]:
                    set_preset_color(effect, original["color"].lstrip("#"))
                own = original["ownBlink"]
                set_preset_blink(effect, None if own is None else own.strip().lower() != "false")
                schedule_reload()
                return self.reply(200, json.dumps({"ok": True}))
            self.reply(404, '{"error": "not found"}')

    return Handler


def edit_panel(open_browser=True):
    if not os.path.isdir(PRESETS):
        print(f"No cursor effects found in {PRESETS}")
        return 1
    original = {}
    for name, _ in presets():
        path = preset_shader(name)
        if path:
            original[name] = {"color": preset_color(name) or "",
                              "ownBlink": settings(os.path.join(PRESETS, f"{name}.conf")).get("cursor-style-blink"),
                              "settings": {s["name"]: s["value"] for s in shader_settings(path)}}
    session = {"token": secrets.token_urlsafe(16), "last": time.time(), "original": original}
    server = ThreadingHTTPServer(("127.0.0.1", 0), make_panel_handler(session))
    session["server"] = server

    def close_when_idle():  # a forgotten panel shuts itself down after an hour without use
        while time.time() - session["last"] < 3600:
            time.sleep(60)
        server.shutdown()

    threading.Thread(target=close_when_idle, daemon=True).start()
    url = f"http://127.0.0.1:{server.server_port}/?t={session['token']}"
    print(f"Cursor effects panel: {url}")
    print("Changes apply to Ghostty as you make them. Close the panel (or press Ctrl-C here) when done.", flush=True)
    if open_browser:
        webbrowser.open(url)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    if session.get("savepoint"):
        print(f"\nDone. Undo everything from this session: bash {shlex.quote(os.path.join(session['savepoint'], 'rollback.sh'))}")
    else:
        print("\nNo changes.")
    return 0


