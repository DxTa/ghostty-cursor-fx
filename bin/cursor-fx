    el.appendChild(b);
  }
  $("#enterSwitch").checked = STATE.enter; showSharedFlags();
}
// A header switch shared by every effect: on, off, or half-filled when the effects differ.
function flagState(name) {
  const vals = new Set(STATE.effects.map(e => (e.settings.find(s => s.name === name) || {}).value).filter(Boolean).map(v => v.trim()));
  return vals.size === 1 ? (vals.has("true") ? "on" : "off") : vals.size ? "mixed" : "n/a";
}
function showSharedFlags() {
  for (const [id, name] of [["#jumpsSwitch", "JUMP_EFFECTS"], ["#idleSwitch", "IDLE_EFFECTS"]]) {
    const st = flagState(name), cb = $(id); cb.checked = st === "on"; cb.indeterminate = st === "mixed";
  }
}
const timers = {};
function debounce(key, ms, fn) { clearTimeout(timers[key]); timers[key] = setTimeout(fn, ms); }

// Every effect's settings come in the same sections, in this order (the `// -- Name` lines in
// its shader). A section's on/off switch sits in its title; IDLE_EFFECTS is the header's.
const SECTION_ORDER = ["Typing", "Enter & done", "Delete-all", "Cursor", "Prompt mark", "Box lines", "Your text", "Look", "Timing"];
const MASTER = { "Typing": "TYPE_EFFECT", "Delete-all": "JUMP_EFFECTS", "Cursor": "CURSOR_EFFECT", "Prompt mark": "PROMPT_EFFECT", "Your text": "TEXT_COLOR" };
const HIDDEN = new Set(["IDLE_EFFECTS"]);
const secTitle = g => UI[LANG]["sec_" + g] ?? UI.en["sec_" + g] ?? groupOf(g);
// A switch's note, read as a sentence: without "the cursor's own look:" and the like (the
// section title says it) and without command-line hints in parentheses.
const PREFIXES = [/^the cursor's own look:\s*/i, /^the prompt mark \(❯\) at the start of the cursor's line:\s*/i, /^the input box lines, always:\s*/i,
  /^光标自身的外观[：:]\s*/, /^(光标所在行开头的|行首的|光标所在行的)提示符（❯）[：:]\s*/, /^输入框(的)?(上下两条)?线条[，,]?\s*(始终|常驻)[^：:]*[：:]\s*/];
const plain = s => { s = s || ""; for (const p of PREFIXES) s = s.replace(p, ""); return s.replace(/\s*[（(][^()（）]*`[^()（）]*[）)]/g, "").replace(/\s*[（(]sRGB[）)]/g, "").trim(); };

// Redraws the selected effect, keeping the scroll position and the open "More settings"
// sections where they were (nothing on the page jumps).
function renderDetail() {
  const panes = ["#knobs", "#detail", "#stage"].map(id => [$(id), ($(id) || {}).scrollTop || 0]), y = window.scrollY;
  const open = new Set([...document.querySelectorAll("#knobs details[open]")].map(d => d.closest(".sec").dataset.group));
  renderDetailNow();
  document.querySelectorAll("#knobs .sec").forEach(s => { if (open.has(s.dataset.group)) { const d = s.querySelector("details"); if (d) d.open = true; } });
  for (const [el, top] of panes) if (el) el.scrollTop = top;
  window.scrollTo(0, y);
  typeReady();
}
function renderDetailNow() {
  const e = effectOf(selected); if (!e) return;
  document.documentElement.style.setProperty("--accent", e.color);
  sim.color = e.color; usePreview(e.source); lastAction = now();
  const d = $("#stage"), k = $("#knobs"); d.innerHTML = ""; k.innerHTML = "";
  const card = document.createElement("div"); card.className = "card";
  const segs = (id, items, cur) => `<div class="seg small" id="${id}" role="radiogroup">${items.map(([v, l]) => `<button type="button" role="radio" data-v="${v}" class="${v === cur ? "on" : ""}">${l}</button>`).join("")}</div>`;
  card.innerHTML = `<div class="title"><h2></h2><div class="actions"><button class="primary" id="useBtn"></button><button id="resetBtn"></button></div></div><p class="desc"></p>
    <div class="preview" id="previewBox" tabindex="0" aria-label="${t("preview")}"><div class="pvzoom"></div><span class="kbd" id="kbdHint">${t("clickToType")}</span><pre class="err" id="previewErr" hidden></pre><textarea id="ime" class="ime" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" aria-label="${t("preview")}"></textarea></div>
    <div class="pvbar"><div class="row"><button data-s="type">${t("sType")}</button><button data-s="enter">${t("sEnter")}</button><button data-s="done">${t("sDone")}</button><button data-s="deleteAll">${t("sDeleteAll")}</button></div>
      <div class="row pvopts"><span class="lbl">${t("zoom")}</span>${segs("zoomSeg", [[1, "1×"], [2, "2×"], [4, "4×"]], ZOOM)}<span class="lbl">${t("speed")}</span>${segs("speedSeg", [[1, "1×"], [0.5, "½×"], [0.25, "¼×"]], SPEED)}</div></div>
    <p class="hint">${t("previewHint")}</p>`;
  card.querySelector("h2").textContent = cap(nameOf(e)); card.querySelector(".desc").textContent = cap(descOf(e)); card.querySelector("#resetBtn").textContent = t("reset");
  const useBtn = card.querySelector("#useBtn"); useBtn.textContent = e.name === STATE.active ? t("inUse") : t("use"); useBtn.disabled = e.name === STATE.active;
  useBtn.onclick = async () => { try { await post("/activate", { effect: e.name }); STATE.active = e.name; toast(t("switched", { effect: cap(nameOf(e)) })); renderList(); renderDetail(); } catch (err) { toast(t("errSwitch", { err: err.message })); } };
  card.querySelector("#resetBtn").onclick = async () => { try { await post("/reset", { effect: e.name }); await refresh(); toast(t("wasReset")); } catch (err) { toast(t("errReset", { err: err.message })); } };
  const box = card.querySelector("#previewBox"), hintEl = card.querySelector("#kbdHint");
  box.querySelector(".pvzoom").appendChild(cv);
  const ime = card.querySelector("#ime"), typeHere = () => ime.focus({ preventScroll: true });
  box.addEventListener("mousedown", ev => { ev.preventDefault(); typeHere(); });
  box.addEventListener("focus", typeHere);
  ime.addEventListener("keydown", previewKey);
  ime.addEventListener("compositionupdate", ev => { sim.preedit = ev.data || ""; lastAction = now(); drawTerm(); });
  ime.addEventListener("compositionend", ev => { sim.preedit = ""; ime.value = ""; if (ev.data) insertText(ev.data); else drawTerm(); });
  ime.addEventListener("input", ev => { if (ev.isComposing) return; const v = ime.value; ime.value = ""; if (v) insertText(v); });
  ime.addEventListener("focus", () => { hintEl.textContent = t("typing"); box.classList.add("focused"); });
  ime.addEventListener("blur", () => { hintEl.textContent = t("clickToType"); box.classList.remove("focused"); if (sim.preedit) { sim.preedit = ""; drawTerm(); } });
  card.querySelectorAll("[data-s]").forEach(b => b.onclick = () => { scenarios[b.dataset.s](); typeHere(); });
  const pickSeg = (id, fn) => card.querySelectorAll(`#${id} button`).forEach(b => b.onclick = () => {
    card.querySelectorAll(`#${id} button`).forEach(x => x.classList.toggle("on", x === b)); fn(Number(b.dataset.v)); typeHere(); });
  pickSeg("zoomSeg", v => { ZOOM = v; applyZoom(); });
  pickSeg("speedSeg", v => setSpeed(v));
  d.appendChild(card);
  requestAnimationFrame(applyZoom);
  // The sections.
  const groups = new Map();
  for (const s of e.settings) {
    if (HIDDEN.has(s.name)) continue;
    const g = s.group || "Other";
    if (!groups.has(g)) groups.set(g, { main: [], fine: [] });
    groups.get(g)[s.section === "fine" ? "fine" : "main"].push(s);
  }
  if (!groups.has("Cursor")) groups.set("Cursor", { main: [], fine: [] });
  const names = [...SECTION_ORDER.filter(g => groups.has(g)), ...[...groups.keys()].filter(g => !SECTION_ORDER.includes(g))];
  for (const g of names) k.appendChild(sectionEl(e, g, groups.get(g)));
  k.insertAdjacentHTML("beforeend", `<p class="hint">${t("settingsHint", { file: e.shader })}</p>`);
}
function sectionEl(e, g, { main, fine }) {
  const sec = document.createElement("section"); sec.className = "sec"; sec.dataset.group = g;
  const head = document.createElement("div"); head.className = "sechead";
  const h = document.createElement("h3"); h.textContent = secTitle(g); head.appendChild(h); sec.appendChild(head);
  const master = MASTER[g] && main.find(s => s.name === MASTER[g]);
  if (master) {
    const row = settingRow(e, master, { markEl: head, onValue: v => sec.classList.toggle("off", !v) });
    const ctl = row.querySelector(".control"); ctl.querySelector("input").setAttribute("aria-label", secTitle(g)); head.appendChild(ctl);
  }
  const text = master ? plain(helpOf(master)) : (UI[LANG]["secd_" + g] ?? UI.en["secd_" + g]);
  if (text) { const p = document.createElement("p"); p.className = "secdesc"; p.textContent = cap(text); sec.appendChild(p); }
  const body = document.createElement("div"); body.className = "group";
  if (g === "Cursor") { body.appendChild(colorRow(e)); body.appendChild(blinkRow(e)); }
  for (const s of main) if (s !== master) body.appendChild(settingRow(e, s));
  if (body.children.length) sec.appendChild(body);
  if (fine.length) {
    const det = document.createElement("details"); det.className = "more";
    det.innerHTML = `<summary>${t("more", { n: fine.length })}</summary>`;
    const fg = document.createElement("div"); fg.className = "group";
    for (const s of fine) fg.appendChild(settingRow(e, s));
    det.appendChild(fg); sec.appendChild(det);
  }
  return sec;
}
// The cursor color (from the effect's preset) and whether it blinks, as rows of the Cursor section.
function colorRow(e) {
  const row = document.createElement("div"); row.className = "setting";
  row.innerHTML = `<label for="colorHex"></label><div class="control"><span class="contrast" id="contrast"></span><input type="color" id="colorPick" aria-label="${t("cursorColor")}"><input type="text" id="colorHex" maxlength="7" spellcheck="false"></div><div class="foot"><div class="help"></div></div>`;
  row.querySelector("label").textContent = t("cursorColor"); row.querySelector(".help").textContent = t("contrastHint");
  const pick = row.querySelector("#colorPick"), hex = row.querySelector("#colorHex"), ctr = row.querySelector("#contrast");
  const showContrast = c => { const r = contrast(c, STATE.colors.background); ctr.innerHTML = `<b>${r.toFixed(1)}:1</b> ${t("contrastOn", { bg: STATE.colors.background })}`; };
  pick.value = e.color; hex.value = e.color; showContrast(e.color);
  const applyColor = c => { if (!/^#[0-9a-fA-F]{6}$/.test(c)) return; pick.value = c; hex.value = c; showContrast(c); sim.color = c; drawTerm(); document.documentElement.style.setProperty("--accent", c);
    setSaving();
    debounce("color", 300, async () => { try { const r = await post("/color", { effect: e.name, color: c }); e.color = r.color; sim.color = r.color; hex.value = r.color; pick.value = r.color; STATE.savepoint = r.savepoint; renderList(); setStatus("saved", t("savedColor", { color: r.color })); } catch (err) { setStatus("error", t("errColor", { err: err.message })); } }); };
  pick.oninput = () => applyColor(pick.value); hex.onchange = () => applyColor(hex.value.startsWith("#") ? hex.value : "#" + hex.value);
  return row;
}
function blinkRow(e) {
  const row = document.createElement("div"); row.className = "setting";
  row.innerHTML = `<label for="blinkSwitch"></label><div class="control"><label class="switch"><input type="checkbox" id="blinkSwitch"> <span class="state"></span></label></div><div class="foot"><div class="help"></div></div>`;
  row.querySelector("label").textContent = t("blinks"); row.querySelector(".help").textContent = t("blinkHint");
  const blink = row.querySelector("#blinkSwitch"), st = row.querySelector(".state");
  const show = () => { blink.checked = e.blink; st.textContent = t(e.blink ? "on" : "off"); }; show();
  blink.onchange = async () => { setSaving(); try { const r = await post("/blink", { effect: e.name, on: blink.checked }); e.blink = r.blink; STATE.savepoint = r.savepoint; show(); setStatus("saved", t(r.blink ? "savedBlinkOn" : "savedBlinkOff", { effect: cap(nameOf(e)) })); } catch (err) { show(); setStatus("error", t("errBlink", { err: err.message })); } };
  return row;
}
// A row's label and note: the panel's own words for the shared switches, the shader's otherwise.
const labelFor = s => UI[LANG]["label_" + s.name] ?? (LANG === "en" ? UI.en["label_" + s.name] : undefined) ?? labelOf(s);
const noteOf = (s, help) => UI[LANG]["hint_" + s.name] ?? cap(plain(noteFor(help, s.group)));
// One setting: a control, the value, a mark when it differs from the value the
// panel opened with (and a button back to it). Edits recompile the preview a
// moment after the last change and save a moment after that; nothing that
// fails to compile is saved. opts.markEl gets the changed mark instead of the row
// (a section title), opts.onValue hears every value (a section dims when off).
function settingRow(e, s, opts = {}) {
  const row = document.createElement("div"); row.className = "setting";
  const label = document.createElement("label"); label.textContent = labelFor(s); label.title = s.name; row.appendChild(label);
  const ctl = document.createElement("div"); ctl.className = "control"; row.appendChild(ctl);
  const original = ((STATE.original[e.name] || {}).settings || {})[s.name];
  let value = parseValue(s.type, s.value);
  const choices = s.type === "int" ? choicesOf(s) : null;
  const shown = v => s.type === "bool" ? t(String(v).trim() === "true" ? "on" : "off")
    : choices ? (choices.items.find(([k]) => k === Number(v)) || [0, v])[1] : v;
  const was = document.createElement("span"); was.className = "was";
  const markChanged = () => { const changed = original !== undefined && s.value !== original; (opts.markEl || row).classList.toggle("changed", changed); row.classList.toggle("changed", changed); if (!was.firstChild && original !== undefined) { was.innerHTML = `${t("was", { value: shown(original) })}<button type="button">↺</button>`; was.querySelector("button").onclick = () => { value = parseValue(s.type, original); setControls(); commit(); }; } };
  let setControls = () => {};
  const commit = () => {
    const source = glsl(s.type, value); if (source === s.value) return;
    const prevSource = e.source, prevValue = s.value;
    s.value = source; e.source = patchSource(e.source, s.name, source); markChanged();
    debounce("compile", 120, () => { usePreview(e.source); lastAction = now(); });
    setSaving();
    debounce("set:" + e.name + ":" + s.name, 320, async () => {
      if (previewError) { e.source = prevSource; s.value = prevValue; value = parseValue(s.type, prevValue); setControls(); markChanged(); usePreview(e.source); setStatus("error", t("noCompile")); return; }
      try { const r = await post("/set", { effect: e.name, name: s.name, type: s.type, value }); STATE.savepoint = r.savepoint; if ((STATE.sharedFlags || []).includes(s.name)) showSharedFlags(); setStatus("saved", t("savedSetting", { name: opts.markEl ? secTitle(s.group) : labelFor(s), value: shown(r.source) })); }
      catch (err) { setStatus("error", t("errSave", { name: labelFor(s), err: err.message })); }
    });
  };
  if (choices) {
    row.classList.add("choice");
    const seg = document.createElement("div"); seg.className = "seg"; seg.setAttribute("role", "radiogroup"); seg.setAttribute("aria-label", labelFor(s));
    const btns = choices.items.map(([v, name]) => {
      const b = document.createElement("button"); b.type = "button"; b.textContent = name; b.setAttribute("role", "radio");
      b.onclick = () => { if (value === v) return; value = v; setControls(); commit(); };
      seg.appendChild(b); return [v, b];
    });
    setControls = () => btns.forEach(([v, b]) => { b.classList.toggle("on", v === value); b.setAttribute("aria-checked", v === value); });
    ctl.appendChild(seg);
  } else if (s.type === "bool") {
    const sw = document.createElement("label"); sw.className = "switch"; sw.innerHTML = `<input type="checkbox"> <span class="state"></span>`;
    const cb = sw.querySelector("input"), txt = sw.querySelector(".state"); cb.setAttribute("aria-label", labelFor(s));
    setControls = () => { cb.checked = value; txt.textContent = t(value ? "on" : "off"); if (opts.onValue) opts.onValue(value); };
    cb.onchange = () => { value = cb.checked; setControls(); commit(); }; ctl.appendChild(sw);
  } else if (s.type === "float" || s.type === "int") {
    const isInt = s.type === "int", v0 = Math.abs(value);
    const max = isInt ? Math.max(4, Math.ceil(v0 * 3)) : v0 <= 0.2 ? 1 : v0 <= 1 ? 2 : Math.ceil(v0 * 3);
    const step = isInt ? 1 : v0 <= 1 ? 0.01 : v0 <= 10 ? 0.05 : 0.5;
    // Most of these divide something: a setting that starts above zero stays above zero.
    const positive = !isInt && value > 0, min = positive ? step : Math.min(0, value);
    const range = document.createElement("input"); range.type = "range"; range.min = min; range.max = Math.max(max, value); range.step = step; range.setAttribute("aria-label", labelFor(s));
    const num = document.createElement("input"); num.type = "number"; num.step = step; num.min = min; num.className = "val"; num.setAttribute("aria-label", labelFor(s));
    setControls = () => { range.value = value; num.value = value; };
    range.oninput = () => { value = Number(range.value); num.value = value; commit(); };
    num.onchange = () => { let v = Number(num.value); if (!isFinite(v)) return; if (positive && v < step) v = step; value = isInt ? Math.round(v) : v; setControls(); commit(); };
    ctl.appendChild(range); ctl.appendChild(num);
  } else if (s.type === "vec3") {
    const pick = document.createElement("input"); pick.type = "color"; pick.setAttribute("aria-label", labelFor(s));
    const hex = document.createElement("input"); hex.type = "text"; hex.maxLength = 7;
    setControls = () => { pick.value = rgbToHex(value); hex.value = pick.value; };
    const set = c => { if (!/^#[0-9a-fA-F]{6}$/.test(c)) return; value = hexToRgb(c); setControls(); commit(); };
    pick.oninput = () => set(pick.value); hex.onchange = () => set(hex.value.startsWith("#") ? hex.value : "#" + hex.value);
    ctl.appendChild(pick); ctl.appendChild(hex);
  } else {
    const nums = value.map((v, i) => { const num = document.createElement("input"); num.type = "number"; num.step = 0.05; num.onchange = () => { const n = Number(num.value); if (isFinite(n)) { value[i] = n; commit(); } }; ctl.appendChild(num); return num; });
    setControls = () => nums.forEach((num, i) => num.value = value[i]);
  }
  setControls(); markChanged();
  const foot = document.createElement("div"); foot.className = "foot";
  const help = document.createElement("div"); help.className = "help"; help.textContent = noteOf(s, choices ? choices.help : helpOf(s)) || "";
  foot.appendChild(help); foot.appendChild(was); row.appendChild(foot);
  return row;
}
function setSaving() { setStatus("saving", t("saving")); }
function setStatus(kind, text) {
  const el = $("#status"); el.className = "pill " + (kind || "");
  if (!kind) text = STATE.savepoint ? t("liveUndo", { path: STATE.savepoint }) : t("live");
  const full = kind === "saved" ? text + " · " + new Date().toLocaleTimeString(LANG === "zh" ? "zh-CN" : undefined) : text;
  el.innerHTML = "<span></span>"; el.firstChild.textContent = full; el.title = full;
  if (kind === "saved") { clearTimeout(timers.status); timers.status = setTimeout(() => setStatus(), 6000); }
}
async function refresh() { STATE = await post("/state"); renderList(); renderDetail(); setStatus(); }
const toggled = (key, on) => toast(t("toggled", { what: t(key), state: t(on ? "on" : "off") }));
$("#enterSwitch").onchange = async ev => { try { await post("/toggle", { what: "enter", on: ev.target.checked }); STATE.enter = ev.target.checked; toggled("enterSw", ev.target.checked); } catch (err) { toast(err.message); } };
$("#jumpsSwitch").onchange = async ev => { try { const r = await post("/toggle", { what: "jumps", on: ev.target.checked }); STATE.jumps = ev.target.checked ? "on" : "off"; toggled("jumpsSw", ev.target.checked); await refresh(); } catch (err) { toast(err.message); } };
$("#idleSwitch").onchange = async ev => { try { const r = await post("/toggle", { what: "idle", on: ev.target.checked }); STATE.idle = ev.target.checked ? "on" : "off"; toggled("idleSw", ev.target.checked); await refresh(); } catch (err) { toast(err.message); } };
$("#doneBtn").onclick = async () => { try { await post("/quit"); } catch (err) {} document.body.innerHTML = `<p style="padding:40px;color:#9a978f">${t("closed")}</p>`; };
$("#langBtn").onclick = () => { LANG = LANG === "zh" ? "en" : "zh"; try { localStorage.setItem("cursor-fx-lang", LANG); } catch (e) {} applyLang(); renderList(); renderDetail(); setStatus(); };
// Typing always goes to the preview: its text field takes the focus back after any click
// or switch, unless a text or number field (a value, a color) is being edited. A key pressed
// while something else has the focus (a button, a slider) is passed on to the preview too.
const isField = el => !!el && !!el.matches && el.matches('input[type=text], input[type=number], input[type=color], input[type=range]');
function typeReady() {
  const ime = $("#ime"), a = document.activeElement;
  if (!ime || a === ime || isField(a) || document.hidden || !document.hasFocus()) return;
  ime.focus({ preventScroll: true });
}
document.addEventListener("pointerup", () => setTimeout(typeReady, 0));
document.addEventListener("change", ev => { if (!isField(ev.target)) setTimeout(typeReady, 0); });
window.addEventListener("focus", () => setTimeout(typeReady, 0));
document.addEventListener("keydown", ev => {
  const ime = $("#ime"), tgt = ev.target;
  if (!ime || tgt === ime || ev.isComposing) return;
  if (isField(tgt) && !(tgt.type === "range" && ev.key.length === 1 && ev.key !== " ")) return;
  if (ev.key === "Tab" || ev.key === "Escape" || ev.key.startsWith("Arrow") || (ev.metaKey && ev.key !== "Backspace") || ev.ctrlKey && ev.key !== "Backspace") return;
  const onControl = tgt && tgt.matches && tgt.matches("button, summary, label, input[type=checkbox]");
  if ((ev.key === "Enter" || ev.key === " ") && onControl) return;  // those press the control
  if (ev.key.length === 1 || ev.key === "Backspace" || ev.key === "Enter" || ev.keyCode === 229) {
    ime.focus({ preventScroll: true });
    if (ev.keyCode !== 229) previewKey(ev);
  }
}, true);
applyLang(); renderList(); renderDetail(); setStatus();
</script>
</body>
</html>
"""


def main(argv):
    if len(argv) > 1 and argv[1] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if len(argv) > 1 and argv[1] == "signal-off":
        return signal_off(*argv[2:5])
    if len(argv) > 1 and argv[1] == "signal":
        try:
            return signal_enter(argv)
        except Exception:  # a hook must never fail loudly
            return 0
    if len(argv) > 1 and argv[1] == "config-path":
        print(CONFIG)
        return 0
    if not os.path.isfile(CONFIG):
        print(f"Ghostty config not found: {CONFIG}")
        return 1
    if len(argv) == 1:
        return list_effects()
    if argv[1] == "enter":
        return set_enter(argv[2] if len(argv) > 2 else None)
    if argv[1] in FLAGS:
        return set_flag(argv[1], argv[2] if len(argv) > 2 else None)
    if argv[1] == "edit":
        return edit_panel(open_browser="--no-open" not in argv)
    name = argv[1][:-5] if argv[1].endswith(".conf") else argv[1]  # (no str.removesuffix: Python 3.8 still works)
    return switch(name)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
